---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStatusBadge from '@/components/EvidenceStatusBadge.astro';
import { getCollection } from 'astro:content';

// Only get published articles (draft: false)
const articles = await getCollection('journal', ({ data }) => !data.draft);

const sortedArticles = articles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const latestArticle = sortedArticles[0];
const remainingArticles = sortedArticles.slice(1);

// Unique categories
const categories = ['All', ...new Set(articles.map((a) => a.data.category))];

// Requirement: Show filters and search bar ONLY when at least 5 articles are published
const showFiltersAndSearch = articles.length >= 5;
---

<BaseLayout
  title="Research Journal"
  description="Independent research articles, literature reviews, and methodological inquiries by Shiwakshi Rashmi."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Header -->
    <header class="space-y-4 mb-8">
      <div class="font-sans text-xs text-fg-muted flex items-center gap-2">
        <span>Independent inquiries</span>
        <span>·</span>
        <a href="/evidence-checks" class="text-link underline underline-offset-2">
          How I check evidence
        </a>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-fg leading-[1.15] tracking-tight">
        Research Journal
      </h1>

      <p class="text-base sm:text-lg text-fg-body leading-relaxed max-w-3xl font-normal">
        Articles, critical literature reviews, and methodological inquiries. Each publication separates verified evidence from professional interpretation.
      </p>
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Filters (Visible only when >= 5 articles published) -->
    {showFiltersAndSearch && (
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4 font-sans text-xs">
        <div class="flex flex-wrap items-center gap-2" id="filter-buttons">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`category-filter-btn px-2.5 py-1 border transition-colors ${
                idx === 0
                  ? 'border-rule-strong font-medium text-fg underline underline-offset-4'
                  : 'border-rule text-fg-muted hover:text-fg'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="text-fg-muted">
          Showing <span id="article-count">{sortedArticles.length}</span> published {sortedArticles.length === 1 ? 'entry' : 'entries'}
        </div>
      </div>
    )}

    <!-- Full-Width Feature for Latest Article -->
    {latestArticle && (
      <section aria-labelledby="featured-inquiry-heading" class="space-y-4 pb-8">
        <h2 id="featured-inquiry-heading" class="font-sans text-xs uppercase tracking-wider text-fg-muted font-semibold m-0">
          Featured inquiry
        </h2>

        <article class="space-y-4">
          <div class="font-sans text-xs text-fg-muted flex flex-wrap items-center gap-2">
            <span>No. {String(latestArticle.data.articleNumber ?? 1).padStart(2, '0')}</span>
            <span>·</span>
            <span>{latestArticle.data.category}</span>
            <span>·</span>
            <EvidenceStatusBadge status={latestArticle.data.researchStatus} />
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl font-normal text-fg leading-tight">
            <a href={`/journal/${latestArticle.slug}`} class="hover:text-link transition-colors">
              {latestArticle.data.title}
            </a>
          </h3>

          {latestArticle.data.subtitle && (
            <p class="font-serif italic text-base sm:text-lg text-fg-body">
              {latestArticle.data.subtitle}
            </p>
          )}

          <p class="text-sm text-fg-body leading-relaxed max-w-3xl">
            {latestArticle.data.abstract}
          </p>

          <p class="font-sans text-xs text-fg-muted pt-1">
            <time datetime={latestArticle.data.publishDate.toISOString()}>
              {latestArticle.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span> · </span>
            <span>{latestArticle.data.readingTime}</span>
          </p>

          <div class="pt-2">
            <a href={`/journal/${latestArticle.slug}`} class="font-sans text-sm text-link underline underline-offset-2">
              Read →
            </a>
          </div>
        </article>
      </section>
    )}

    <!-- Editorial List for Subsequent Articles -->
    {remainingArticles.length > 0 && (
      <section class="mt-8 pt-8 border-t border-rule space-y-6">
        <h2 class="font-sans text-xs uppercase tracking-wider text-fg-muted font-semibold m-0">
          All inquiries
        </h2>
        <div>
          {remainingArticles.map((article, idx) => (
            <ArticleCard
              title={article.data.title}
              subtitle={article.data.subtitle}
              slug={article.slug}
              publishDate={article.data.publishDate}
              readingTime={article.data.readingTime}
              category={article.data.category}
              abstract={article.data.abstract}
              researchStatus={article.data.researchStatus}
              researchQuestion={article.data.researchQuestion}
              articleNumber={idx + 2}
              tags={article.data.tags}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Calm Link to Evidence Standards -->
    <div class="mt-16 pt-8 border-t border-rule font-sans text-xs text-fg-muted flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <span>All citations are verified against original primary sources before publication.</span>
      <a href="/evidence-checks" class="text-link underline underline-offset-2 shrink-0">
        How I check evidence →
      </a>
    </div>
  </main>
</BaseLayout>
