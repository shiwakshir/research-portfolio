---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';

// Only get published articles (exclude drafts)
const articles = await getCollection('journal', ({ data }) => !data.draft);

const sortedArticles = articles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Collect unique categories from published articles
const categories = ['All', ...new Set(articles.map((a) => a.data.category))];
---

<BaseLayout
  title="Research Journal & Publication Index"
  description="Substantial, referenced articles and literature reviews exploring UX research methodology, digital health, and human-centred systems."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Header -->
    <header class="max-w-3xl mb-12 border-b border-parchment-300 dark:border-ink-800 pb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-2">
        Independent Inquiries & Literature Reviews
      </span>
      <h1 class="font-editorial-heading font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink-900 dark:text-ink-50 mb-4">
        Research Journal
      </h1>
      <p class="text-base sm:text-lg text-ink-700 dark:text-ink-300 leading-relaxed">
        A publication space for substantive, well-referenced research articles, critical reviews, and methodological reflections. Each piece adheres to our research standards, separating evidence from exploratory interpretation.
      </p>
    </header>

    <!-- Category Filters -->
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2" id="filter-buttons">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`category-filter-btn px-3 py-1.5 text-xs font-medium rounded border transition-colors ${
              idx === 0
                ? 'bg-forest-700 text-parchment-50 border-forest-700 font-semibold active-filter'
                : 'bg-parchment-100 dark:bg-ink-900 border-parchment-300 dark:border-ink-700 text-ink-700 dark:text-ink-300 hover:border-forest-600'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="text-xs text-ink-500 font-mono">
        Showing <span id="article-count">{sortedArticles.length}</span> published {sortedArticles.length === 1 ? 'article' : 'articles'}
      </div>
    </div>

    <!-- Article List -->
    {sortedArticles.length > 0 ? (
      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedArticles.map((article) => (
          <div class="article-item" data-category={article.data.category}>
            <ArticleCard
              title={article.data.title}
              subtitle={article.data.subtitle}
              slug={article.slug}
              publishDate={article.data.publishDate}
              readingTime={article.data.readingTime}
              category={article.data.category}
              abstract={article.data.abstract}
              researchStatus={article.data.researchStatus}
              tags={article.data.tags}
              seriesTitle={article.data.series?.title}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center rounded border border-dashed border-parchment-300 dark:border-ink-800">
        <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-100 mb-2">
          New Research Under Preparation
        </h3>
        <p class="text-sm text-ink-600 dark:text-ink-400 max-w-md mx-auto mb-4">
          Articles for our initial multi-part inquiry into fluctuating health conditions are currently undergoing literature synthesis.
        </p>
        <a href="/series" class="text-xs font-semibold text-forest-700 dark:text-forest-400 underline">
          View the planned series outline →
        </a>
      </div>
    )}

    <!-- Editorial Note on Drafts & Integrity -->
    <div class="mt-16 p-6 rounded bg-parchment-150 dark:bg-ink-900/40 border border-parchment-300 dark:border-ink-800 text-xs text-ink-600 dark:text-ink-400 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <strong class="text-ink-900 dark:text-ink-200 block mb-1">Editorial Standard & Draft Isolation:</strong>
        <span>All unpublished manuscripts, literature notes, and planned series installments remain private drafts until peer reference checks and methodological reviews are finalized.</span>
      </div>
      <a href="/rss.xml" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-parchment-50 dark:bg-ink-800 border border-parchment-300 dark:border-ink-700 font-medium text-ink-700 dark:text-ink-300 hover:text-forest-700">
        Subscribe via RSS ↗
      </a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const buttons = document.querySelectorAll('.category-filter-btn');
  const items = document.querySelectorAll('.article-item');
  const countSpan = document.getElementById('article-count');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // Update button styles
      buttons.forEach(b => {
        b.classList.remove('bg-forest-700', 'text-parchment-50', 'border-forest-700', 'font-semibold', 'active-filter');
        b.classList.add('bg-parchment-100', 'border-parchment-300', 'text-ink-700');
      });
      btn.classList.add('bg-forest-700', 'text-parchment-50', 'border-forest-700', 'font-semibold', 'active-filter');
      btn.classList.remove('bg-parchment-100', 'border-parchment-300', 'text-ink-700');

      let visible = 0;
      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selected === 'All' || itemCat === selected) {
          item.classList.remove('hidden');
          visible++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countSpan) countSpan.textContent = String(visible);
    });
  });
</script>
