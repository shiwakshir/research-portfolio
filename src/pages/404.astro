---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested research document or page could not be located."
>
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center space-y-6">
    <p class="font-sans text-xs uppercase tracking-widest text-fg-muted">
      Status 404
    </p>
    
    <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-tight">
      Document not found
    </h1>
    
    <p class="summary mx-auto">
      The inquiry, project, or page you requested does not exist or may have been relocated during an editorial revision.
    </p>

    <div class="pt-6 flex flex-wrap items-center justify-center gap-6 font-sans text-sm">
      <a
        href="/"
        class="text-link underline underline-offset-2"
      >
        Return home →
      </a>
      <a
        href="/journal"
        class="text-link underline underline-offset-2"
      >
        Browse journal
      </a>
    </div>
  </main>
</BaseLayout>
