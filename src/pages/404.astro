---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The requested research document or page could not be located."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center space-y-6">
    <span class="text-xs font-mono uppercase tracking-widest text-forest-700 dark:text-forest-400 font-bold">
      Status 404
    </span>
    
    <h1 class="font-editorial-heading font-serif text-4xl sm:text-5xl font-bold text-ink-950 dark:text-ink-50">
      Document Not Found
    </h1>
    
    <p class="text-base text-ink-600 dark:text-ink-300 leading-relaxed max-w-md mx-auto">
      The article, series installment, or page you requested does not exist or may have been relocated during an editorial revision.
    </p>

    <div class="pt-4 flex flex-wrap items-center justify-center gap-4 text-sm">
      <a
        href="/"
        class="px-5 py-2.5 rounded bg-forest-700 text-parchment-50 hover:bg-forest-800 font-medium transition-colors"
      >
        Return to Home →
      </a>
      <a
        href="/journal"
        class="px-5 py-2.5 rounded border border-parchment-300 dark:border-darkSurface-700 text-ink-800 dark:text-ink-200 hover:border-forest-600 font-medium transition-colors"
      >
        Browse Research Journal
      </a>
    </div>
  </div>
</BaseLayout>
