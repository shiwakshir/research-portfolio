---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import EvidenceStatusBadge from '@/components/EvidenceStatusBadge.astro';
import Figure from '@/components/Figure.astro';
import { getCollection } from 'astro:content';

// Only get published articles (draft: false)
const allPublishedArticles = await getCollection('journal', ({ data }) => !data.draft);
const sortedArticles = allPublishedArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const latestArticle = sortedArticles[0];

// Get approved projects
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const leadProject = sortedProjects.find(p => p.data.isLead) || sortedProjects[0];
const consultancyProjects = sortedProjects.filter(p => !p.data.isLead);

// Dynamic theme counts (only show counts above zero)
const themes = [
  {
    title: "Digital Health & Wellbeing",
    count: allPublishedArticles.filter(a => a.data.category === "Digital Health").length,
    description: "Managing treatment burden, cognitive overhead, and interface friction in self-management.",
  },
  {
    title: "Chronic & Fluctuating Conditions",
    count: allPublishedArticles.filter(a => a.data.category === "Chronic Health").length,
    description: "Everyday realities of non-linear illness, energy pacing, and routine volatility.",
  },
  {
    title: "Applied AI in UX & Market Research",
    count: allPublishedArticles.filter(a => a.data.category === "Applied AI").length,
    description: "Evaluating agentic brief analysis, bias risks, and synthetic respondent limitations.",
  },
  {
    title: "UX Research Methods",
    count: allPublishedArticles.filter(a => a.data.category === "UX Research Methods").length,
    description: "Mixed-methods architectures, evidence hierarchies, and structured discovery protocols.",
  },
  {
    title: "Human Behaviour & Lived Experience",
    count: allPublishedArticles.filter(a => a.data.category === "Human Behaviour").length,
    description: "Observational fieldwork versus retrospective self-reporting and social desirability.",
  },
];
---

<BaseLayout>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Masthead Section per §7.2 & Mock 5a -->
    <header class="space-y-6">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Independent research journal and portfolio · London
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.18] tracking-tight">
        {SITE.tagline}
      </h1>

      <p class="lede">
        I am an Insights Manager specialising in UX and market research, exploring the intersection of human experience, chronic health conditions and applied technology. This website is where I document independent research, methodological reflections and selected projects.
      </p>

      <!-- Slim Proof Line (no dot bullets, plain text and middots) -->
      <p class="font-sans text-xs text-fg-muted pt-2">
        Insights Manager, UX, C Space · Five years of consultancy research across technology, generative AI, automotive, financial services and FMCG
      </p>
    </header>

    <hr class="border-t border-rule-strong my-12" />

    <!-- Latest in the Journal per Mock 5a -->
    {latestArticle && (
      <section aria-labelledby="latest-journal-heading">
        <div class="flex items-center justify-between mb-8">
          <h2 id="latest-journal-heading" class="font-sans text-xs uppercase tracking-wider text-fg-muted font-semibold m-0">
            Latest in the journal
          </h2>
          <a href="/journal" class="font-sans text-xs text-link underline underline-offset-2 hover:opacity-80">
            All entries
          </a>
        </div>

        <article class="space-y-4">
          <!-- Editorial Number, Category & Evidence Status -->
          <div class="font-sans text-xs text-fg-muted flex flex-wrap items-center gap-2">
            <span>No. {String(latestArticle.data.articleNumber ?? 1).padStart(2, '0')}</span>
            <span>·</span>
            <span>{latestArticle.data.category}</span>
            <span>·</span>
            <EvidenceStatusBadge status={latestArticle.data.researchStatus} />
          </div>

          <!-- Article Title -->
          <h3 class="font-serif text-2xl sm:text-3xl font-normal text-fg leading-tight">
            <a href={`/journal/${latestArticle.slug}`} class="hover:text-link transition-colors">
              {latestArticle.data.title}
            </a>
          </h3>

          <!-- Subtitle / Research Question -->
          {latestArticle.data.subtitle && (
            <p class="font-serif italic text-base sm:text-lg text-fg-body">
              {latestArticle.data.subtitle}
            </p>
          )}

          <!-- Summary -->
          <p class="summary">
            {latestArticle.data.abstract}
          </p>

          <!-- Date and Reading Time -->
          <p class="font-sans text-xs text-fg-muted pt-1">
            <time datetime={latestArticle.data.publishDate.toISOString()}>
              {latestArticle.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span> · </span>
            <span>{latestArticle.data.readingTime}</span>
          </p>

          <!-- Ruled Study Note (<dl>) with zero unverified fallbacks (§1.5) -->
          {(latestArticle.data.researchQuestion || latestArticle.data.methodsSummary || latestArticle.data.limitations) && (
            <dl class="mt-6 border-t border-rule pt-4 grid grid-cols-1 md:grid-cols-3 gap-6 font-sans text-sm">
              {latestArticle.data.researchQuestion && (
                <div>
                  <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Question</dt>
                  <dd class="font-serif italic text-fg text-sm leading-relaxed m-0">
                    {latestArticle.data.researchQuestion}
                  </dd>
                </div>
              )}
              {latestArticle.data.methodsSummary && (
                <div>
                  <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Method</dt>
                  <dd class="text-fg-body text-xs leading-relaxed m-0">
                    {latestArticle.data.methodsSummary}
                  </dd>
                </div>
              )}
              {latestArticle.data.limitations && (
                <div>
                  <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Limits</dt>
                  <dd class="text-fg-body text-xs leading-relaxed m-0">
                    {latestArticle.data.limitations}
                  </dd>
                </div>
              )}
            </dl>
          )}

          <div class="pt-4">
            <a href={`/journal/${latestArticle.slug}`} class="font-sans text-sm text-link underline underline-offset-2">
              Read →
            </a>
          </div>
        </article>
      </section>
    )}

    <hr class="border-t border-rule-strong my-12" />

    <!-- Selected Work per §1.4 & Mock 5a -->
    <section aria-labelledby="selected-work-heading" class="space-y-8">
      <div class="flex items-center justify-between">
        <h2 id="selected-work-heading" class="font-sans text-xs uppercase tracking-wider text-fg-muted font-semibold m-0">
          Selected work
        </h2>
        <a href="/projects" class="font-sans text-xs text-link underline underline-offset-2 hover:opacity-80">
          All projects
        </a>
      </div>

      <!-- Lead Project: BRIEF -->
      {leadProject && (
        <article class="space-y-4">
          <h3 class="font-serif text-2xl font-normal text-fg">
            {leadProject.data.title}
          </h3>

          <p class="summary">
            {leadProject.data.summary}
          </p>

          <!-- Stated once: Calm credit line -->
          {leadProject.data.award && (
            <p class="font-sans text-xs text-fg-muted">
              {leadProject.data.award}
            </p>
          )}

          <div class="flex items-center gap-4 pt-1 font-sans text-sm">
            <a href={`/projects/${leadProject.slug}`} class="text-link underline underline-offset-2">
              Case study
            </a>
            <a href={SITE.author.briefGithub} target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">
              Source ↗
            </a>
          </div>

          <!-- Captioned Figure (§6.5 & §1.2) -->
          <div class="pt-4 max-w-3xl">
            <Figure
              src="/brief-architecture.svg"
              alt="BRIEF 11-step methodological audit pipeline"
              caption="BRIEF's 11-step advisory review pipeline."
              n={1}
              href={SITE.author.briefGithub}
            />
          </div>
        </article>
      )}

      <!-- Consultancy Projects (Rendered dynamically from verified content collection, §1.4) -->
      <div class="pt-6 space-y-4 border-t border-rule">
        {consultancyProjects.map((project) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 items-baseline py-3 border-b border-rule last:border-b-0">
            <div class="md:col-span-7">
              <h4 class="font-serif text-base text-fg font-normal">
                <a href={`/projects/${project.slug}`} class="hover:text-link transition-colors">
                  {project.data.title}
                </a>
              </h4>
            </div>
            <div class="md:col-span-5 md:text-right">
              <p class="font-sans text-xs text-fg-muted">
                {project.data.sector} · {project.data.methods.slice(0, 2).join(', ')} · {project.data.role}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-t border-rule-strong my-12" />

    <!-- Research Themes per Mock 5a & §4 -->
    <section aria-labelledby="themes-heading" class="space-y-8">
      <div class="flex items-center justify-between">
        <h2 id="themes-heading" class="font-sans text-xs uppercase tracking-wider text-fg-muted font-semibold m-0">
          Research themes
        </h2>
        <a href="/interests" class="font-sans text-xs text-link underline underline-offset-2 hover:opacity-80">
          Themes overview →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
        {themes.map((theme) => (
          <div class="space-y-1.5">
            <h3 class="font-serif text-base text-fg font-normal">
              {theme.title}
              {theme.count > 0 && <span class="font-sans text-xs text-fg-muted font-normal ml-1">· {theme.count}</span>}
            </h3>
            <p class="font-sans text-xs text-fg-muted leading-relaxed">
              {theme.description}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
