---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import ArticleCard from '@/components/ArticleCard.astro';
import SeriesCard from '@/components/SeriesCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';

// Only get published articles (draft: false)
const allPublishedArticles = await getCollection('journal', ({ data }) => !data.draft);
const recentArticles = allPublishedArticles
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// Get series
const allSeries = await getCollection('series');
const featuredSeries = allSeries.find(s => s.data.featured) || allSeries[0];

// Get featured projects
const featuredProjects = await getCollection('projects', ({ data }) => !data.draft && data.featured);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-parchment-300 dark:border-ink-800">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-forest-600 animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest font-semibold text-forest-700 dark:text-forest-400">
          Independent Research & UX Publication
        </span>
      </div>

      <h1 class="font-editorial-heading font-serif text-3xl sm:text-5xl lg:text-5xl font-bold tracking-tight text-ink-950 dark:text-ink-50 leading-[1.15] mb-6">
        {SITE.tagline}
      </h1>

      <p class="text-lg sm:text-xl text-ink-700 dark:text-ink-300 leading-relaxed mb-8 font-normal">
        I am a UX and market research professional exploring the intersection of human experience, chronic health, and technology. This is where I document my independent research, emerging questions, and projects.
      </p>

      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a
          href="/journal"
          class="px-5 py-2.5 rounded bg-forest-700 text-parchment-50 hover:bg-forest-800 font-medium transition-colors shadow-sm focus-visible:ring-2 focus-visible:ring-forest-600"
        >
          Explore Research Journal →
        </a>
        <a
          href="/about"
          class="px-5 py-2.5 rounded border border-parchment-300 dark:border-ink-700 text-ink-800 dark:text-ink-200 hover:border-forest-600 dark:hover:border-forest-500 font-medium transition-colors"
        >
          About My Background
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Research Series Banner -->
  {featuredSeries && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-parchment-300 dark:border-ink-800">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-1">
            Focus Inquiry
          </span>
          <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-semibold text-ink-900 dark:text-ink-50">
            Featured Research Series
          </h2>
        </div>
        <a href="/series" class="text-xs font-semibold text-forest-700 dark:text-forest-400 hover:underline">
          All series ({allSeries.length}) →
        </a>
      </div>

      <SeriesCard
        title={featuredSeries.data.title}
        subtitle={featuredSeries.data.subtitle}
        slug={featuredSeries.slug}
        status={featuredSeries.data.status}
        description={featuredSeries.data.description}
        proposedArticles={featuredSeries.data.proposedArticles}
      />
    </section>
  )}

  <!-- Recent Articles Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-parchment-300 dark:border-ink-800">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-1">
          Recent Writing
        </span>
        <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-semibold text-ink-900 dark:text-ink-50">
          From the Research Journal
        </h2>
      </div>
      <a href="/journal" class="text-xs font-semibold text-forest-700 dark:text-forest-400 hover:underline">
        Browse all articles →
      </a>
    </div>

    {recentArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            subtitle={article.data.subtitle}
            slug={article.slug}
            publishDate={article.data.publishDate}
            readingTime={article.data.readingTime}
            category={article.data.category}
            abstract={article.data.abstract}
            researchStatus={article.data.researchStatus}
            tags={article.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 rounded border border-dashed border-parchment-300 dark:border-ink-800 text-center">
        <p class="text-sm text-ink-600 dark:text-ink-400">
          Articles in the first research series are currently under active synthesis and editorial review.
        </p>
      </div>
    )}
  </section>

  <!-- Research Themes Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-parchment-300 dark:border-ink-800">
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-1">
        Inquiry Directions
      </span>
      <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-semibold text-ink-900 dark:text-ink-50 mb-3">
        Selected Research Themes
      </h2>
      <p class="text-sm text-ink-600 dark:text-ink-400 leading-relaxed">
        My emerging independent investigations focus on understanding human systems under conditions of unpredictability, fatigue, and methodological change.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SITE.researchThemes.map((theme) => (
        <div class="p-6 rounded bg-card/60 dark:bg-ink-900/40 border border-parchment-300 dark:border-ink-800 hover:border-forest-600 transition-colors flex flex-col justify-between">
          <div>
            <h3 class="font-editorial-heading font-serif text-lg font-semibold text-ink-900 dark:text-ink-100 mb-2">
              {theme.title}
            </h3>
            <p class="text-xs text-ink-600 dark:text-ink-400 leading-relaxed mb-4">
              {theme.description}
            </p>
          </div>
          <ul class="space-y-1 pt-3 border-t border-parchment-200 dark:border-ink-800 text-[11px] text-ink-500 dark:text-ink-400">
            {theme.focusAreas.map((area) => (
              <li class="flex items-center gap-1.5">
                <span class="w-1 h-1 rounded-full bg-forest-600"></span>
                <span>{area}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8 text-right">
      <a href="/interests" class="text-xs font-semibold text-forest-700 dark:text-forest-400 hover:underline">
        Detailed research interests overview →
      </a>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-parchment-300 dark:border-ink-800">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-1">
          Applied Work
        </span>
        <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-semibold text-ink-900 dark:text-ink-50">
          Selected Projects & Case Studies
        </h2>
      </div>
      <a href="/projects" class="text-xs font-semibold text-forest-700 dark:text-forest-400 hover:underline">
        All projects →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          summary={project.data.summary}
          role={project.data.role}
          problem={project.data.problem}
          approach={project.data.approach}
          methods={project.data.methods}
          timeline={project.data.timeline}
          status={project.data.status}
          slug={project.slug}
        />
      ))}
    </div>
  </section>

  <!-- Connect & Dialogue Invitation -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="p-8 sm:p-12 rounded bg-parchment-150 dark:bg-ink-900/60 border border-parchment-300 dark:border-ink-800 max-w-3xl mx-auto text-center space-y-6">
      <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-semibold text-ink-900 dark:text-ink-50">
        Interested in Dialogue or Collaboration?
      </h2>
      <p class="text-sm text-ink-700 dark:text-ink-300 leading-relaxed max-w-xl mx-auto">
        I welcome thoughtful conversations with researchers, designers, health practitioners, and people with lived experience of chronic or fluctuating health conditions.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/contact"
          class="px-5 py-2.5 rounded bg-forest-700 text-parchment-50 hover:bg-forest-800 text-sm font-medium transition-colors"
        >
          Connect With Me
        </a>
        <a
          href={SITE.author.linkedIn}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded border border-parchment-300 dark:border-ink-700 text-ink-800 dark:text-ink-200 hover:border-forest-600 text-sm font-medium transition-colors"
        >
          LinkedIn Profile ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
