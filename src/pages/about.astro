---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

// Requirement: Hide photo space until author supplies the photograph
const hasAuthorPhoto = false; // [TO CONFIRM - set to true and add image to public/avatar.jpg when ready]

const careerTimeline = [
  {
    role: "Insights Manager, UX",
    company: "C Space",
    period: "Current",
    description: "Leading qualitative and quantitative UX research across technology, generative AI, and multi-market initiatives. Designing research frameworks that connect consumer understanding to strategic product decisions.",
  },
  {
    role: "Consultant",
    company: "C Space",
    period: "Previous",
    description: "Executed end-to-end qualitative investigations, longitudinal diary studies, customer journey mapping, and survey analyses across automotive, FMCG and financial services sectors.",
  },
  {
    role: "Associate Consultant",
    company: "C Space",
    period: "Earlier",
    description: "Conducted in-depth participant interviews, usability sessions, ethnographic fieldwork, and thematic qualitative coding.",
  },
];
---

<BaseLayout
  title="About Shiwakshi Rashmi"
  description="Insights Manager, UX, at C Space with over five years of consultancy research experience across technology, generative AI, automotive, financial services and FMCG."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Top Header -->
    <header class="mb-12 pb-10 border-b border-parchment-300 dark:border-darkSurface-750">
      <div class="space-y-3 max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block">
          Professional Background
        </span>
        <h1 class="font-editorial-heading font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink-950 dark:text-ink-50">
          {SITE.author.name}
        </h1>
        <p class="text-base sm:text-lg text-forest-800 dark:text-forest-300 font-medium">
          {SITE.author.fullTitle} · {SITE.author.location}
        </p>
        <p class="text-sm sm:text-base text-ink-700 dark:text-ink-200 leading-relaxed font-normal">
          {SITE.author.experienceSummary}
        </p>

        <!-- Recognition Badge -->
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-forest-50 dark:bg-darkSurface-800 text-forest-800 dark:text-forest-200 border border-forest-200 dark:border-forest-800 text-xs font-semibold">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {SITE.author.award}
          </span>
        </div>
      </div>

      <!-- Author photo space (Cleanly hidden until photograph is provided) -->
      {hasAuthorPhoto && (
        <div class="mt-8 pt-6 border-t border-parchment-200 dark:border-darkSurface-750">
          <div class="w-40 h-40 rounded bg-parchment-200 dark:bg-darkSurface-800 overflow-hidden">
            <img src="/avatar.jpg" alt={`Portrait of ${SITE.author.name}`} class="w-full h-full object-cover" />
          </div>
        </div>
      )}
    </header>

    <!-- Narrative Prose -->
    <div class="prose prose-lg dark:prose-invert max-w-none space-y-10">
      <section>
        <h2 class="font-editorial-heading font-serif text-2xl font-semibold text-ink-950 dark:text-ink-50">
          Consultancy Research Practice
        </h2>
        <p>
          Over five years of consultancy research, my practice has focused on unearthing human realities to inform product strategy. I lead and contribute to mixed-methods programs spanning five international markets, working with teams across the UK, EMEA and the US.
        </p>
        <p>
          My work spans the full research spectrum:
        </p>
        <ul>
          <li><strong>Qualitative Discovery:</strong> In-depth interview guides, longitudinal multi-day diary studies, contextual inquiry, and usability evaluations across technology and automotive sectors.</li>
          <li><strong>Quantitative Validation:</strong> International survey research, cross-market weighting, questionnaire harmonization, and statistical analysis.</li>
          <li><strong>Applied Artificial Intelligence:</strong> Building agentic research evaluation tools—such as BRIEF, which evaluates research designs across 11 autonomous agents using Microsoft Foundry and Azure AI Search.</li>
        </ul>
      </section>

      <!-- Short Career Timeline -->
      <section class="not-prose my-12 pt-8 border-t border-parchment-300 dark:border-darkSurface-750">
        <h2 class="font-editorial-heading font-serif text-2xl font-semibold text-ink-950 dark:text-ink-50 mb-6">
          Career Timeline
        </h2>
        <div class="space-y-6">
          {careerTimeline.map((item, index) => (
            <div class="p-6 rounded border border-parchment-300 dark:border-darkSurface-750 bg-card/60 dark:bg-darkSurface-850/60 relative pl-8">
              <span class="absolute left-3 top-7 w-2 h-2 rounded-full bg-forest-600"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
                <h3 class="font-editorial-heading font-serif text-lg font-bold text-ink-950 dark:text-ink-50">
                  {item.role}
                </h3>
                <span class="text-xs font-mono text-forest-800 dark:text-forest-300 font-semibold">
                  {item.period} · {item.company}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-ink-600 dark:text-ink-300 leading-relaxed m-0">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="font-editorial-heading font-serif text-2xl font-semibold text-ink-950 dark:text-ink-50">
          Independent Inquiries
        </h2>
        <p>
          In parallel with consultancy work, I investigate areas where standard product design assumptions break down—particularly in digital health self-management, chronic and fluctuating health conditions, and cognitive tracking burden.
        </p>
        <p>
          I explore these questions through literature reviews and conceptual frameworks, grounding every piece in verified empirical evidence.
        </p>
      </section>

      <!-- Link to Research Interests -->
      <div class="not-prose my-10 p-6 rounded bg-parchment-150 dark:bg-darkSurface-850 border border-parchment-300 dark:border-darkSurface-750 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-serif font-semibold text-base text-ink-900 dark:text-ink-50 mb-1">
            Current Research Agenda
          </h3>
          <p class="text-xs text-ink-600 dark:text-ink-300 m-0">
            Explore my active questions across digital health, human behaviour, and applied AI in research.
          </p>
        </div>
        <a
          href="/interests"
          class="shrink-0 px-4 py-2 rounded bg-forest-700 text-parchment-50 text-xs font-semibold hover:bg-forest-800 transition-colors inline-flex items-center gap-1"
        >
          View Research Interests →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
