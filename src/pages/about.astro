---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const hasAuthorPhoto = false; // [TO CONFIRM - set to true and add image to public/avatar.jpg when ready]

---

<BaseLayout
  title="About Shiwakshi Rashmi"
  description="Shiwakshi Rashmi is an Insights Manager in UX and market research, and publishes independent research on digital health, human behaviour and applied AI."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Top Header -->
    <header class="space-y-4 mb-8">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Professional background
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.15] tracking-tight">
        {SITE.author.name}
      </h1>

      <p class="font-sans text-xs text-fg-muted">
        {SITE.author.fullTitle} · {SITE.author.location}
      </p>

      <p class="lede">
        {SITE.author.experienceSummary}
      </p>

      <!-- Author photo space (hidden until photo supplied) -->
      {hasAuthorPhoto && (
        <div class="mt-8 pt-6 border-t border-rule">
          <div class="w-36 h-36 border border-rule overflow-hidden">
            <img src="/avatar.jpg" alt={`Portrait of ${SITE.author.name}`} class="w-full h-full object-cover" />
          </div>
        </div>
      )}
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Narrative Prose -->
    <div class="prose max-w-[38rem]">
      <p>I am an Insights Manager with over five years of professional experience in UX and market research. I work with qualitative and quantitative methods, survey design and multi-market research. My academic background is in philosophy and sociology.</p>
      <p>This site is my independent work. It does not represent my employer, and it contains no employer or client work.</p>

      <h2>What I research</h2>
      <p>I study what happens when people live with conditions that change from day to day, and how digital tools help or add to the work. I also study how research teams use AI, and where AI weakens the evidence.</p>
      <p>I publish literature reviews, critical analyses and open questions here, one piece at a time. Each piece states its method and its limits. I am not a clinician, and nothing here is medical advice. I have no institutional affiliation at present.</p>

      <h2>What I build</h2>
      <p>I also build research tools. <a href="/projects/brief-agentic-evaluation">BRIEF</a> audits what AI already assumes about a research topic before fieldwork begins. It won the Hack for Good Award at Microsoft Agents League @ AI Skills Fest 2026. See <a href="/projects">all projects</a>.</p>

      <h2>Work with me</h2>
      <p>I would like to hear from researchers, patient advocates, healthcare professionals and people with lived experience. <a href="/contact">Contact me</a>, or read <a href="/evidence-checks">how I check evidence</a>.</p>
    </div>
  </main>
</BaseLayout>
