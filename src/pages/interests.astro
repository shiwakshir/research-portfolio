---
import BaseLayout from '@/layouts/BaseLayout.astro';

const themes = [
  {
    number: "01",
    title: "Digital Health & Wellbeing",
    summary: "Investigating how individuals navigate long-term, episodic, and fluctuating illnesses, and where digital tools fail to support unpredictable daily capacity.",
    questions: [
      "Why do streak-based habit loops and aggressive push notifications trigger guilt and tool abandonment during symptom flares?",
      "How can software dynamically adapt its interface complexity based on momentary cognitive bandwidth?",
      "What is the difference between clinical treatment adherence and sustainable everyday pacing?"
    ],
    theoreticalAnchor: "Informed by burden-of-treatment theory, patient-reported outcome measures, and health human-computer interaction (HCI)."
  },
  {
    number: "02",
    title: "Chronic & Fluctuating Conditions",
    summary: "Examining the divergence between designer assumptions, clinical protocols, and the messy, adaptive ways people organise their lives in domestic and workplace contexts.",
    questions: [
      "How do people negotiate invisible trade-offs between managing health regimens and preserving vocational or social identity?",
      "What environmental workarounds do users invent that formal surveys routinely fail to measure?",
      "How does retrospective recall bias distort user feedback in health and lifestyle research?"
    ],
    theoreticalAnchor: "Informed by qualitative sociology (Strauss & Corbin), ecological momentary assessment, and behavioural economics."
  },
  {
    number: "03",
    title: "Applied AI in UX & Market Research",
    summary: "Critically evaluating where large language models and autonomous agent workflows enhance research synthesis, and where they risk hallucinating false consensus.",
    questions: [
      "Can synthetic user personas ever accurately simulate the lived experience of fluctuating illness, or do they inevitably reinforce stereotypes?",
      "How can researchers use AI tools for thematic clustering while preserving raw human nuance and counter-narratives?",
      "What audit trails are necessary to maintain research integrity when deploying multi-agent evaluation systems like BRIEF?"
    ],
    theoreticalAnchor: "Informed by emerging HCI literature on human-AI collaboration, algorithmic bias, and research ethics."
  },
  {
    number: "04",
    title: "UX Research Methods",
    summary: "Refining mixed-methods research architectures that integrate qualitative contextual depth with quantitative statistical validity.",
    questions: [
      "How can practitioners structure research roadmaps so generative discovery continuously sharpens survey design?",
      "What are the boundary conditions of small-sample usability testing when designing for complex or fluctuating user states?",
      "How do we measure latent emotional burden rather than just task completion time?"
    ],
    theoreticalAnchor: "Informed by mixed-methods research design (Creswell), survey methodology, and five years of consultancy practice."
  },
  {
    number: "05",
    title: "Human Behaviour & Lived Experience",
    summary: "Establishing pragmatic evidence hierarchies that help product and business teams ground strategic roadmaps in validated human truth rather than organisational bias.",
    questions: [
      "How do we communicate varying levels of research confidence transparently to cross-functional stakeholders?",
      "When is a prototype experiment sufficient to commit engineering resources, and when is longitudinal validation required?",
      "How can teams resist the temptation of vanity analytics that measure engagement rather than genuine human utility?"
    ],
    theoreticalAnchor: "Informed by decision science, epistemology of evidence, and user experience strategy."
  }
];
---

<BaseLayout
  title="Research Themes"
  description="Current areas of independent investigation: digital health, chronic conditions, human behaviour, research methods, and applied AI by Shiwakshi Rashmi."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Header -->
    <header class="space-y-4 mb-8">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Agenda & exploration
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.15] tracking-tight">
        Research Themes
      </h1>

      <p class="lede">
        These are ongoing directions of inquiry, reading, and conceptual design. They represent active curiosity and structured investigation rather than claims of definitive academic authority.
      </p>
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Theme Pillars (Serif lists at 16px without left bars per §4) -->
    <div class="space-y-12">
      {themes.map((theme) => (
        <section class="space-y-4 py-8 border-b border-rule first:pt-0">
          <div class="font-sans text-xs text-fg-muted">
            Theme {theme.number}
          </div>

          <h2 class="font-serif text-2xl font-normal text-fg">
            {theme.title}
          </h2>

          <p class="summary">
            {theme.summary}
          </p>

          <div class="pt-2">
            <span class="font-sans text-xs font-semibold uppercase tracking-wider text-fg-muted block mb-2">
              Questions under study:
            </span>
            <ul class="space-y-2 font-serif italic text-base text-fg-body max-w-2xl list-disc pl-5">
              {theme.questions.map((q) => (
                <li class="leading-relaxed">
                  {q}
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-2 font-sans text-xs text-fg-muted">
            <span>Theoretical anchor: </span>
            <span class="text-fg-body">{theme.theoreticalAnchor}</span>
          </div>
        </section>
      ))}
    </div>

    <!-- Contact Link -->
    <div class="pt-8 font-sans text-xs text-fg-muted flex items-center justify-between">
      <span>Investigating similar questions or have literature recommendations?</span>
      <a href="/contact" class="text-link underline underline-offset-2">
        Reach out for dialogue →
      </a>
    </div>
  </main>
</BaseLayout>
