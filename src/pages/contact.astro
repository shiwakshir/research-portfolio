---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Contact"
  description="Connect with Shiwakshi Rashmi regarding UX research, digital health inquiries, and research methodology."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Header -->
    <header class="space-y-4 mb-8">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Connect
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.15] tracking-tight">
        Contact
      </h1>

      <p class="lede">
        I welcome conversations with researchers, practitioners, advocates, and individuals exploring human experience, digital health, and research methodology.
      </p>
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Direct Communication Links at the Top per §4 -->
    <section class="space-y-6 my-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 font-sans text-sm">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-fg-muted font-semibold block">Email</span>
          <a
            href={`mailto:${SITE.author.email}`}
            class="text-base text-link underline underline-offset-2 break-all"
          >
            {SITE.author.email}
          </a>
        </div>

        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-fg-muted font-semibold block">LinkedIn</span>
          <a
            href={SITE.author.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="text-base text-link underline underline-offset-2 break-all"
          >
            LinkedIn Profile ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Scope & Boundary Note per §4 -->
    <section class="border-t border-b border-rule py-4 my-8 font-sans text-sm text-fg-body space-y-1">
      <strong class="text-fg block text-xs uppercase tracking-wider">Privacy & medical scope boundary</strong>
      <p class="m-0 leading-relaxed text-sm">
        Please do not submit personal medical records, confidential clinical histories, or urgent health queries. I am an Insights Manager specialising in UX research, not a doctor or medical clinician. This website cannot evaluate symptoms or provide medical guidance.
      </p>
    </section>

    <!-- One sentence on who you want to hear from (Cut 6-item grid per §4) -->
    <section class="pt-4 font-sans text-sm text-fg-muted">
      <p class="m-0 leading-relaxed">
        I am particularly keen to hear from researchers, clinicians, patient advocates, and individuals navigating long-term or fluctuating conditions who want to share perspectives on everyday tool burden and research methodology.
      </p>
    </section>
  </main>
</BaseLayout>
