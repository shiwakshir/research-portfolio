---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects & Applied Work"
  description="Selected independent AI systems and consultancy UX research by Shiwakshi Rashmi."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Header -->
    <header class="space-y-4 mb-8">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Selected work & applied practice
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-fg leading-[1.15] tracking-tight">
        Projects & Applied Work
      </h1>

      <p class="text-base sm:text-lg text-fg-body leading-relaxed max-w-3xl font-normal">
        A selection of independent systems and consultancy research engagements. Commercial client names and proprietary data remain strictly confidential; project descriptions represent verified methodologies and exact roles.
      </p>
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Projects List -->
    <div class="space-y-4">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          summary={project.data.summary}
          role={project.data.role}
          sector={project.data.sector}
          methods={project.data.methods}
          order={project.data.order}
          isLead={project.data.isLead}
          award={project.data.award}
          techStack={project.data.techStack}
          slug={project.slug}
        />
      ))}
    </div>
  </main>
</BaseLayout>
