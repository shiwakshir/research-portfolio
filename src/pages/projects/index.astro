---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects & Applied Research"
  description="Consultancy research case studies and independent AI evaluation tools by Shiwakshi Rashmi."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Header -->
    <header class="max-w-3xl mb-12 border-b border-parchment-300 dark:border-darkSurface-750 pb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-2">
        Portfolio & Case Studies
      </span>
      <h1 class="font-editorial-heading font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink-950 dark:text-ink-50 mb-4">
        Projects & Applied Work
      </h1>
      <p class="text-base sm:text-lg text-ink-700 dark:text-ink-200 leading-relaxed font-normal">
        A selection of independent AI research systems and consultancy UX research programs. Each project outlines the exact role, research methods, and sector context.
      </p>
    </header>

    <!-- Projects Grid / Stack -->
    <div class="space-y-10">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          summary={project.data.summary}
          role={project.data.role}
          sector={project.data.sector}
          methods={project.data.methods}
          order={project.data.order}
          isLead={project.data.isLead}
          award={project.data.award}
          techStack={project.data.techStack}
          slug={project.slug}
        />
      ))}
    </div>

    <!-- Confidentiality Note -->
    <div class="mt-16 p-6 rounded bg-parchment-150 dark:bg-darkSurface-850 border border-parchment-300 dark:border-darkSurface-750 text-xs text-ink-600 dark:text-ink-400 leading-relaxed">
      <h3 class="font-serif font-semibold text-sm text-ink-900 dark:text-ink-100 mb-2">
        Client Confidentiality & Research Ethics
      </h3>
      <p class="mb-0">
        In accordance with professional consultancy standards and non-disclosure agreements, commercial clients remain strictly anonymous. Proprietary client datasets, product roadmaps, and unreleased feature designs are omitted. All project descriptions reflect my verified roles and methodological contributions.
      </p>
    </div>
  </div>
</BaseLayout>
