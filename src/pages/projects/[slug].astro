---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BriefPipeline from '@/components/BriefPipeline.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
  return projectEntries.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 font-sans text-xs text-fg-muted flex items-center gap-2">
      <a href="/projects" class="hover:text-link underline underline-offset-2">Projects</a>
      <span>/</span>
      <span>{project.data.sector}</span>
    </nav>

    <!-- Project Header -->
    <header class="space-y-4 mb-8 pb-8 border-b border-rule">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        {project.data.sector}
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.15] tracking-tight">
        {project.data.title}
      </h1>

      <p class="lede">
        {project.data.summary}
      </p>

      {project.data.isLead && project.data.award && (
        <p class="font-sans text-xs text-fg-muted pt-1">
          {project.data.award}
        </p>
      )}

      <!-- Metadata <dl> with 12px labels per §4 -->
      <dl class="pt-6 grid grid-cols-1 sm:grid-cols-2 gap-6 font-sans text-xs border-t border-rule">
        <div>
          <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Role</dt>
          <dd class="text-fg leading-relaxed m-0">{project.data.role}</dd>
        </div>
        <div>
          <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Methods</dt>
          <dd class="text-fg leading-relaxed m-0">{project.data.methods.join(', ')}</dd>
        </div>
      </dl>
    </header>

    <!-- If BRIEF, render Figure with honest 11-step advisory architecture -->
    {project.data.isLead && (
      <BriefPipeline />
    )}

    <!-- Case Study Body -->
    <div class="prose max-w-[38rem]">
      <Content />
    </div>

    <div class="mt-14 pt-8 border-t border-rule flex items-center justify-between font-sans text-xs">
      <a href="/projects" class="text-link underline underline-offset-2">
        ← Back to all projects
      </a>
      {project.data.githubUrl && (
        <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">
          View repository on GitHub ↗
        </a>
      )}
    </div>
  </main>
</BaseLayout>
