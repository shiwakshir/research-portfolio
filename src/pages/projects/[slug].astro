---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Figure from '@/components/Figure.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
  return projectEntries.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const formattedOrder = String(project.data.order).padStart(2, '0');
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 font-sans text-xs text-fg-muted flex items-center gap-2">
      <a href="/projects" class="hover:text-link underline underline-offset-2">Projects</a>
      <span>/</span>
      <span>Project {formattedOrder}</span>
    </nav>

    <!-- Project Header -->
    <header class="space-y-4 mb-10 pb-8 border-b border-rule">
      <div class="font-sans text-xs text-fg-muted flex flex-wrap items-center gap-2">
        <span>Project {formattedOrder}</span>
        <span>·</span>
        <span>{project.data.sector}</span>
        {project.data.isLead && (
          <>
            <span>·</span>
            <span>Lead Project</span>
          </>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-fg leading-[1.15] tracking-tight">
        {project.data.title}
      </h1>

      <p class="text-base sm:text-lg text-fg-body leading-relaxed max-w-3xl">
        {project.data.summary}
      </p>

      {project.data.award && (
        <p class="font-sans text-xs text-fg-muted">
          {project.data.award}
        </p>
      )}

      <!-- Metadata Line -->
      <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-xs border-t border-rule">
        <div>
          <span class="text-fg-muted block uppercase tracking-wider text-[10px] mb-1">Role & Responsibility</span>
          <span class="text-fg">{project.data.role}</span>
        </div>
        <div>
          <span class="text-fg-muted block uppercase tracking-wider text-[10px] mb-1">Research Methods</span>
          <span class="text-fg">{project.data.methods.join(', ')}</span>
        </div>
      </div>
    </header>

    <!-- If BRIEF, render Figure with honest architecture preview -->
    {project.data.isLead && (
      <div class="mb-12">
        <Figure
          src="/brief-architecture.svg"
          alt="BRIEF 11-agent architecture"
          caption="BRIEF's agent review of a sample brief."
          n={1}
          href="https://github.com/shiwakshir/brief"
        />
      </div>
    )}

    <!-- Case Study Body -->
    <div class="prose dark:prose-invert max-w-[38rem]">
      <Content />
    </div>

    <div class="mt-14 pt-8 border-t border-rule flex items-center justify-between font-sans text-xs">
      <a href="/projects" class="text-link underline underline-offset-2">
        ← Back to all projects
      </a>
      {project.data.isLead && (
        <a href="https://github.com/shiwakshir/brief" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">
          View BRIEF Repository on GitHub ↗
        </a>
      )}
    </div>
  </main>
</BaseLayout>
