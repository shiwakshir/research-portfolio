---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
  return projectEntries.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-ink-500 dark:text-ink-400">
      <a href="/projects" class="hover:text-forest-700 dark:hover:text-forest-300">Projects</a>
      <span>/</span>
      <span class="font-mono text-ink-700 dark:text-ink-300">Project No. 0{project.data.order}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 border-b border-parchment-300 dark:border-darkSurface-750 pb-8">
      {project.data.award && (
        <div class="mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-forest-50 dark:bg-darkSurface-800 text-forest-800 dark:text-forest-200 border border-forest-200 dark:border-forest-800 text-xs font-semibold">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {project.data.award}
          </span>
        </div>
      )}

      <h1 class="font-editorial-heading font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-950 dark:text-ink-50 mb-4 leading-tight">
        {project.data.title}
      </h1>
      
      <p class="text-base sm:text-lg text-ink-700 dark:text-ink-200 leading-relaxed mb-6 font-normal">
        {project.data.summary}
      </p>

      <!-- Meta Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 rounded bg-parchment-150 dark:bg-darkSurface-850 text-xs border border-parchment-200 dark:border-darkSurface-750">
        <div>
          <span class="text-ink-500 uppercase tracking-wider block font-semibold text-[10px] mb-1">Sector</span>
          <span class="font-semibold text-ink-900 dark:text-ink-100">{project.data.sector}</span>
        </div>
        <div>
          <span class="text-ink-500 uppercase tracking-wider block font-semibold text-[10px] mb-1">My Exact Role</span>
          <span class="font-medium text-ink-900 dark:text-ink-100">{project.data.role}</span>
        </div>
        <div class="sm:col-span-2 pt-2 border-t border-parchment-200 dark:border-darkSurface-750">
          <span class="text-ink-500 uppercase tracking-wider block font-semibold text-[10px] mb-2">Research & Technical Methods</span>
          <div class="flex flex-wrap gap-1.5">
            {project.data.methods.map((method: string) => (
              <span class="px-2.5 py-1 rounded bg-parchment-200 dark:bg-darkSurface-800 text-ink-800 dark:text-ink-200 font-mono text-[11px]">
                {method}
              </span>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- If BRIEF, render interactive BrowserFrame -->
    {project.data.isLead && (
      <div class="mb-10">
        <BrowserFrame url="brief-evaluator.internal.ai" />
      </div>
    )}

    <!-- Case Study Body -->
    <div class="prose prose-lg dark:prose-invert max-w-none pt-4">
      <Content />
    </div>

    <div class="mt-14 pt-8 border-t border-parchment-300 dark:border-darkSurface-750 flex items-center justify-between text-xs">
      <a href="/projects" class="font-semibold text-forest-700 dark:text-forest-400 hover:underline">
        ← Back to all projects
      </a>
      <a href="/journal" class="font-semibold text-forest-700 dark:text-forest-400 hover:underline">
        Explore research journal →
      </a>
    </div>
  </div>
</BaseLayout>
