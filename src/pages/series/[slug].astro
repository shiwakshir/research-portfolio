---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const seriesEntries = await getCollection('series', ({ data }) => data.isPublic);
  return seriesEntries.map((series) => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props;
const { Content } = await series.render();

// Check which articles in the journal match this series and are published
const publishedJournalArticles = await getCollection('journal', ({ data }) => !data.draft && data.series?.id === series.slug);
---

<BaseLayout
  title={series.data.title}
  description={series.data.description}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 font-sans text-xs text-fg-muted flex items-center gap-2">
      <a href="/series" class="hover:text-link underline underline-offset-2">Series Index</a>
      <span>/</span>
      <span>{series.data.status}</span>
    </nav>

    <!-- Series Header -->
    <header class="space-y-4 mb-8">
      <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
        Series {series.data.order} · {series.data.status}
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-fg leading-[1.15] tracking-tight">
        {series.data.title}
      </h1>

      {series.data.subtitle && (
        <p class="font-serif italic text-lg sm:text-xl text-fg-body">
          {series.data.subtitle}
        </p>
      )}

      <p class="text-base sm:text-lg text-fg-body leading-relaxed max-w-3xl font-normal">
        {series.data.description}
      </p>
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <!-- Series Content & Articles -->
    <div class="prose max-w-[38rem] space-y-6">
      <Content />

      {publishedJournalArticles.length > 0 ? (
        <section class="mt-8 pt-8 border-t border-rule">
          <h2 class="font-serif text-2xl font-normal text-fg mb-4">
            Published Inquiries in This Series
          </h2>
          <div class="space-y-4 not-prose">
            {publishedJournalArticles.map((article) => (
              <div class="py-3 border-b border-rule space-y-1">
                <a href={`/journal/${article.slug}`} class="font-serif text-base text-fg hover:text-link transition-colors block">
                  {article.data.title}
                </a>
                <p class="font-sans text-xs text-fg-muted">
                  Part {article.data.series?.order} · {article.data.readingTime}
                </p>
              </div>
            ))}
          </div>
        </section>
      ) : (
        <div class="mt-8 pt-6 border-t border-rule font-sans text-xs text-fg-muted">
          <em>Articles in this series are currently in preparation.</em>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
