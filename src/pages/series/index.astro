---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allSeries = await getCollection('series');
// Filter to series approved for public display
const publicSeries = allSeries.filter(s => s.data.isPublic);
---

<BaseLayout
  title="Research Series"
  description="Thematic, longitudinal inquiries exploring fluctuating health conditions and research methodology."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Header -->
    <header class="max-w-3xl mb-12 border-b border-parchment-300 dark:border-darkSurface-750 pb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-400 block mb-2">
        Longitudinal Collections
      </span>
      <h1 class="font-editorial-heading font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink-950 dark:text-ink-50 mb-4">
        Research Series
      </h1>
      <p class="text-base sm:text-lg text-ink-700 dark:text-ink-200 leading-relaxed font-normal">
        Longitudinal inquiries group related research papers, literature syntheses, and qualitative findings into sequential trajectories.
      </p>
    </header>

    {publicSeries.length > 0 ? (
      <div class="space-y-8">
        {publicSeries.map((series) => (
          <div class="p-8 rounded border border-parchment-300 dark:border-darkSurface-750 bg-card dark:bg-darkSurface-850">
            <span class="text-xs font-mono uppercase text-forest-800 dark:text-forest-300 font-semibold mb-2 block">
              Series {series.data.order} · {series.data.status}
            </span>
            <h2 class="font-editorial-heading font-serif text-2xl sm:text-3xl font-bold text-ink-950 dark:text-ink-50 mb-3">
              <a href={`/series/${series.slug}`} class="hover:text-forest-700 dark:hover:text-forest-300">
                {series.data.title}
              </a>
            </h2>
            <p class="text-sm text-ink-700 dark:text-ink-300 leading-relaxed mb-4">
              {series.data.description}
            </p>
            <a href={`/series/${series.slug}`} class="text-xs font-semibold text-forest-700 dark:text-forest-400 hover:underline">
              Explore series hub →
            </a>
          </div>
        ))}
      </div>
    ) : (
      <div class="p-10 rounded border border-parchment-300 dark:border-darkSurface-750 bg-parchment-150/60 dark:bg-darkSurface-850 text-center max-w-2xl mx-auto space-y-4">
        <div class="w-10 h-10 rounded-full bg-forest-100 dark:bg-darkSurface-800 text-forest-800 dark:text-forest-300 mx-auto flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="font-editorial-heading font-serif text-2xl font-bold text-ink-950 dark:text-ink-50">
          First Research Series in Preparation
        </h3>
        <p class="text-xs sm:text-sm text-ink-600 dark:text-ink-300 leading-relaxed">
          My first independent research series—<strong>Living with Fluctuating Health</strong>—is currently undergoing literature reviews and synthesis. In keeping with my research standards, article titles and manuscripts remain in private editorial planning until finalized for release.
        </p>
        <div class="pt-2">
          <a
            href="/journal"
            class="inline-flex items-center gap-1 text-xs font-semibold text-forest-800 dark:text-forest-300 hover:underline"
          >
            Read currently published papers in the Journal →
          </a>
        </div>
      </div>
    )}

    <!-- Editorial Standards Note -->
    <div class="mt-16 p-5 rounded bg-parchment-150 dark:bg-darkSurface-850 border border-parchment-300 dark:border-darkSurface-750 text-xs text-ink-600 dark:text-ink-400">
      <strong class="text-ink-900 dark:text-ink-100 block mb-1">How Research Series Progress</strong>
      <span>A series moves from exploratory scope and literature reviews to qualitative reflections and conceptual design frameworks. Each installment is published only after thorough evidence verification.</span>
    </div>
  </div>
</BaseLayout>
