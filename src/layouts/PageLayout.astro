---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="space-y-4 mb-8">
      {subtitle && (
        <p class="font-sans text-xs text-fg-muted uppercase tracking-wider">
          {subtitle}
        </p>
      )}
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-fg leading-[1.15] tracking-tight">
        {title}
      </h1>
      {description && (
        <p class="text-base sm:text-lg text-fg-body max-w-3xl leading-relaxed font-normal">
          {description}
        </p>
      )}
    </header>

    <hr class="border-t border-rule-strong my-8" />

    <div class="prose dark:prose-invert max-w-[38rem]">
      <slot />
    </div>
  </main>
</BaseLayout>
