---
import BaseLayout from './BaseLayout.astro';
import ReferencesList from '@/components/ReferencesList.astro';
import EvidenceStatusBadge from '@/components/EvidenceStatusBadge.astro';
import { SITE } from '@/config/site';

interface Props {
  entry: any;
  headings: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: any;
  nextPost?: any;
}

const { entry, prevPost, nextPost } = Astro.props;
const { data } = entry;

const formattedPublishDate = data.publishDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formattedNumber = String(data.articleNumber || 1).padStart(2, '0');
---
<BaseLayout
  title={data.title}
  description={data.abstract}
  articleDate={data.publishDate}
  articleAuthor={data.author}
>
  <!-- Article Wrapper: 56rem container so margin notes sit comfortably in the gutter at >= 1200px -->
  <main>
  <article class="max-w-[56rem] mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Editorial Header per §7.3 & Mock 5b -->
    <header class="space-y-4 max-w-[38rem] mb-10">
      <!-- Number, Category, Series -->
      <div class="font-sans text-xs text-fg-muted flex flex-wrap items-center gap-2">
        <span>No. {formattedNumber}</span>
        <span>·</span>
        <span>{data.category}</span>
        {data.series && (
          <>
            <span>·</span>
            <span>{data.series.title || data.series.id}{data.series.part ? `, part ${data.series.part}` : ''}</span>
          </>
        )}
      </div>

      <!-- Title -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.6rem] font-normal text-fg leading-[1.15] tracking-tight">
        {data.title}
      </h1>

      <!-- Subtitle / Research Question -->
      {data.subtitle && (
        <p class="font-serif italic text-lg sm:text-xl text-fg-body leading-relaxed">
          {data.subtitle}
        </p>
      )}

      <!-- Byline Line -->
      <p class="font-sans text-xs text-fg-muted pt-1">
        <span>{data.author || SITE.author.name}</span>
        <span> · </span>
        <time datetime={data.publishDate.toISOString()}>{formattedPublishDate}</time>
        <span> · </span>
        <span>{data.readingTime}</span>
      </p>

      <!-- Ruled Study Note (<dl>) with 14px text and zero unverified fallbacks (§1.5 & §7.3) -->
      <dl class="my-8 border-t border-b border-rule py-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 font-sans text-sm">
        {data.researchQuestion && (
          <div class="sm:col-span-2">
            <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Question</dt>
            <dd class="font-serif italic text-fg text-base leading-relaxed m-0">
              {data.researchQuestion}
            </dd>
          </div>
        )}

        <div>
          <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Status</dt>
          <dd class="m-0 pt-0.5">
            <EvidenceStatusBadge status={data.researchStatus} />
          </dd>
        </div>

        {data.methodsSummary && (
          <div>
            <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Method</dt>
            <dd class="text-fg-body text-sm leading-relaxed m-0">
              {data.methodsSummary}
            </dd>
          </div>
        )}

        {data.limitations && (
          <div>
            <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Limits</dt>
            <dd class="text-fg-body text-sm leading-relaxed m-0">
              {data.limitations}
            </dd>
          </div>
        )}

        <div>
          <dt class="text-fg-muted font-semibold uppercase tracking-wider text-xs mb-1">Scope</dt>
          <dd class="text-fg-body text-sm leading-relaxed m-0">
            UX inquiry, not clinical advice. Independent, not peer-reviewed.
            <a href="/evidence-checks" class="text-link underline underline-offset-2 ml-1">
              How I check evidence →
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <!-- Main Markdown Prose Body -->
    <div class="prose max-w-[38rem]">
      <slot />
    </div>

    <!-- References & Backlinks -->
    <div class="max-w-[38rem] mt-12 pt-8 border-t border-rule">
      <ReferencesList references={data.references} />
    </div>

    <!-- Adjacent Article Navigation -->
    {(prevPost || nextPost) && (
      <nav aria-label="Adjacent articles" class="max-w-[38rem] grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12 pt-8 border-t border-rule font-sans">
        {prevPost ? (
          <a
            href={`/journal/${prevPost.slug}`}
            class="group text-left"
          >
            <span class="text-xs uppercase tracking-wider text-fg-muted block mb-1">← Previous Inquiry</span>
            <span class="font-serif text-sm text-fg group-hover:text-link transition-colors line-clamp-2">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}

        {nextPost && (
          <a
            href={`/journal/${nextPost.slug}`}
            class="group text-right"
          >
            <span class="text-xs uppercase tracking-wider text-fg-muted block mb-1">Next Inquiry →</span>
            <span class="font-serif text-sm text-fg group-hover:text-link transition-colors line-clamp-2">
              {nextPost.data.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </article>
  </main>
</BaseLayout>
