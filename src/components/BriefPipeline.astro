---
const steps = ['Parse the brief','Generate query variants','Query the model in many voices','Cluster the assumptions','Gap analysis against the audience','Temporal drift check','Score hypothesis contamination','Competitor and brand priming','Trace assumption origins','Recommend methodology','Confidence synthesis'];
---
<figure class="m-0 my-8 max-w-[38rem] border-y border-rule py-4 font-sans text-sm">
  <figcaption class="mb-3 text-xs font-semibold uppercase tracking-[.08em] text-fg-muted">The eleven steps in BRIEF</figcaption>
  <ol class="m-0 list-decimal pl-6 sm:columns-2 sm:gap-8 text-fg-body">
    {steps.map((s) => <li class="mb-1 break-inside-avoid">{s}</li>)}
  </ol>
</figure>
