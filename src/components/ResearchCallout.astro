---
interface Props {
  type?: 'methods' | 'limitations' | 'evidence' | 'note';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles = {
  methods: {
    border: 'border-l-4 border-forest-600 bg-forest-50/70 dark:bg-forest-950/30',
    titleColor: 'text-forest-800 dark:text-forest-200',
    defaultTitle: 'Research Methodology & Approach Note',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
  },
  limitations: {
    border: 'border-l-4 border-amber-600 bg-amber-50/60 dark:bg-amber-950/20',
    titleColor: 'text-amber-800 dark:text-amber-300',
    defaultTitle: 'Methodological Boundaries & Limitations',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  },
  evidence: {
    border: 'border-l-4 border-slateAccent-600 bg-slateAccent-50/60 dark:bg-slateAccent-950/30',
    titleColor: 'text-slateAccent-800 dark:text-slateAccent-200',
    defaultTitle: 'Where the Literature & Evidence Diverge',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  },
  note: {
    border: 'border-l-4 border-ink-400 bg-parchment-200/50 dark:bg-ink-900/40',
    titleColor: 'text-ink-900 dark:text-ink-100',
    defaultTitle: 'Editorial Note',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
};

const current = styles[type];
const displayTitle = title || current.defaultTitle;
---
<aside class={`my-6 p-4 rounded-r text-sm leading-relaxed ${current.border}`}>
  <div class={`flex items-center gap-2 font-semibold mb-2 ${current.titleColor}`}>
    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={current.icon} />
    </svg>
    <span>{displayTitle}</span>
  </div>
  <div class="text-ink-700 dark:text-ink-300 space-y-2">
    <slot />
  </div>
</aside>
