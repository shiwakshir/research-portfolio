---
interface Props {
  variant?: 'forest' | 'slate' | 'ink' | 'subtle' | 'status';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'subtle', size = 'sm', class: className = '' } = Astro.props;

const variants = {
  forest: 'bg-forest-50 text-forest-700 border-forest-200 dark:bg-forest-900/30 dark:text-forest-200 dark:border-forest-800',
  slate: 'bg-slateAccent-50 text-slateAccent-700 border-slateAccent-100 dark:bg-slateAccent-700/20 dark:text-slateAccent-100 dark:border-slateAccent-700',
  ink: 'bg-ink-100 text-ink-800 border-ink-200 dark:bg-ink-800 dark:text-ink-200 dark:border-ink-700',
  subtle: 'bg-parchment-200 text-ink-700 border-parchment-300 dark:bg-ink-800/60 dark:text-ink-300 dark:border-ink-700',
  status: 'bg-forest-50 text-forest-800 border-forest-200 font-medium dark:bg-forest-900/40 dark:text-forest-200 dark:border-forest-700',
};

const sizes = {
  sm: 'text-xs px-2.5 py-0.5 tracking-wider uppercase font-medium',
  md: 'text-sm px-3 py-1 font-medium',
};
---
<span class={`inline-flex items-center rounded-sm border ${variants[variant]} ${sizes[size]} ${className}`}>
  <slot />
</span>
