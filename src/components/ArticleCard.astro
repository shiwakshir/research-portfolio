---
import EvidenceStatusBadge from './EvidenceStatusBadge.astro';

interface Props {
  title: string;
  subtitle?: string;
  slug: string;
  publishDate: Date;
  readingTime: string;
  category: string;
  abstract: string;
  researchStatus?: string;
  researchQuestion?: string;
  articleNumber?: number;
  tags?: string[];
  seriesTitle?: string;
}

const {
  title,
  subtitle,
  slug,
  publishDate,
  readingTime,
  category,
  abstract,
  researchStatus = 'Critical review',
  researchQuestion,
  articleNumber = 1,
  tags = [],
} = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formattedNumber = String(articleNumber).padStart(2, '0');
---
<article class="space-y-3 py-6 border-b border-rule">
  <!-- Metadata Line: No. 01 · Category · Date · Read time · Status -->
  <div class="font-sans text-xs text-fg-muted flex flex-wrap items-center gap-2">
    <span>No. {formattedNumber}</span>
    <span>·</span>
    <span>{category}</span>
    <span>·</span>
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    <span>·</span>
    <span>{readingTime}</span>
    <span>·</span>
    <EvidenceStatusBadge status={researchStatus} />
  </div>

  <!-- Title -->
  <h3 class="font-serif text-xl sm:text-2xl font-normal text-fg leading-snug">
    <a href={`/journal/${slug}`} class="hover:text-link transition-colors">
      {title}
    </a>
  </h3>

  {subtitle && (
    <p class="font-serif italic text-sm sm:text-base text-fg-body">
      {subtitle}
    </p>
  )}

  {researchQuestion && (
    <p class="font-serif italic text-sm text-fg-body border-l border-rule-strong pl-3 my-2">
      "{researchQuestion}"
    </p>
  )}

  <p class="summary">
    {abstract}
  </p>

  <div class="pt-2 flex items-center justify-between font-sans text-xs">
    <div class="flex gap-2 text-fg-muted">
      {tags.slice(0, 2).map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
    <a href={`/journal/${slug}`} class="text-link underline underline-offset-2">
      Read →
    </a>
  </div>
</article>
