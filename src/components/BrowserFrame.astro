---
interface Props {
  url?: string;
  title?: string;
}

const { url = 'brief-evaluator.internal.ai', title = 'BRIEF — 11-Agent Methodology Evaluator' } = Astro.props;
---
<div class="rounded-lg overflow-hidden border border-parchment-300 dark:border-darkSurface-700 bg-card dark:bg-darkSurface-850 shadow-sm my-6">
  <!-- Browser Chrome Top Bar -->
  <div class="px-4 py-2.5 bg-parchment-200/80 dark:bg-darkSurface-800 border-b border-parchment-300 dark:border-darkSurface-700 flex items-center justify-between gap-4">
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full bg-red-400/80 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-amber-400/80 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-400/80 inline-block"></span>
    </div>
    
    <div class="flex-1 max-w-sm mx-auto px-3 py-1 rounded bg-parchment-50 dark:bg-darkSurface-900 border border-parchment-300 dark:border-darkSurface-700 text-center text-xs font-mono text-ink-600 dark:text-ink-400 truncate">
      https://{url}
    </div>

    <div class="w-12 text-right">
      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-forest-100 text-forest-800 dark:bg-darkSurface-750 dark:text-forest-300 font-semibold">11 Agents</span>
    </div>
  </div>

  <!-- Browser Content -->
  <div class="p-6 font-sans">
    <slot>
      <!-- Default Interactive Mock of BRIEF UI -->
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-parchment-200 dark:border-darkSurface-750">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2 py-0.5 rounded bg-forest-700 text-parchment-50 text-[10px] font-bold tracking-wider uppercase">BRIEF Agent Engine</span>
              <span class="text-xs text-ink-500">v1.2 · Azure AI Search + Foundry</span>
            </div>
            <h4 class="font-serif font-semibold text-lg text-ink-900 dark:text-ink-50">Evaluation Dashboard: Quantitative Usability Brief #408</h4>
          </div>
          
          <div class="flex items-center gap-3 p-2.5 rounded bg-parchment-150 dark:bg-darkSurface-800 border border-parchment-300 dark:border-darkSurface-700 shrink-0">
            <div class="text-right">
              <span class="text-[10px] uppercase font-bold text-ink-500 block">Confidence Score</span>
              <span class="text-xs text-forest-700 dark:text-forest-400 font-medium">Methodological Fit</span>
            </div>
            <div class="w-12 h-12 rounded-full border-2 border-forest-600 flex items-center justify-center font-editorial-heading font-serif text-xl font-bold text-ink-900 dark:text-ink-50">
              86
            </div>
          </div>
        </div>

        <!-- 11 Agents Evaluation Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
          <div class="p-3 rounded bg-parchment-100/60 dark:bg-darkSurface-800/60 border border-parchment-200 dark:border-darkSurface-750">
            <div class="flex items-center justify-between mb-1">
              <span class="font-semibold text-ink-900 dark:text-ink-100">01 Sample Balance Agent</span>
              <span class="text-[10px] text-forest-700 dark:text-forest-400 font-mono">92/100</span>
            </div>
            <p class="text-[11px] text-ink-600 dark:text-ink-400">Demographic quotas sound. Minor under-representation in secondary markets.</p>
          </div>

          <div class="p-3 rounded bg-parchment-100/60 dark:bg-darkSurface-800/60 border border-parchment-200 dark:border-darkSurface-750">
            <div class="flex items-center justify-between mb-1">
              <span class="font-semibold text-ink-900 dark:text-ink-100">02 Cognitive Bias Agent</span>
              <span class="text-[10px] text-amber-700 dark:text-amber-400 font-mono">74/100</span>
            </div>
            <p class="text-[11px] text-ink-600 dark:text-ink-400">Question 7 contains double-barrelled phrasing. Revision recommended.</p>
          </div>

          <div class="p-3 rounded bg-parchment-100/60 dark:bg-darkSurface-800/60 border border-parchment-200 dark:border-darkSurface-750">
            <div class="flex items-center justify-between mb-1">
              <span class="font-semibold text-ink-900 dark:text-ink-100">03 Objective Alignment</span>
              <span class="text-[10px] text-forest-700 dark:text-forest-400 font-mono">95/100</span>
            </div>
            <p class="text-[11px] text-ink-600 dark:text-ink-400">Primary hypotheses mapped directly to intended survey instruments.</p>
          </div>
        </div>

        <div class="p-3 rounded bg-forest-50/60 dark:bg-darkSurface-800 border border-forest-200 dark:border-forest-900 text-xs flex items-center justify-between">
          <span class="text-ink-800 dark:text-ink-200">Independent architecture built using Flask, Microsoft Foundry, and Azure AI Search.</span>
          <span class="text-[10px] font-semibold text-forest-800 dark:text-forest-300">Hack for Good Winner · AI Skills Fest 2026</span>
        </div>
      </div>
    </slot>
  </div>
</div>
