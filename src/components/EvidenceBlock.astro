---
interface Props {
  type: 'what-the-evidence-says' | 'my-interpretation' | 'where-the-evidence-disagrees' | 'open-question';
  title?: string;
}

const LABELS = {
  'what-the-evidence-says': 'What the evidence says',
  'my-interpretation': 'My interpretation',
  'where-the-evidence-disagrees': 'Where the evidence disagrees',
  'open-question': 'Open question',
};

const { type, title } = Astro.props;
const label = title ?? LABELS[type];
const voice = type === 'my-interpretation' || type === 'open-question' ? 'italic' : '';
---
<aside class="relative my-10 py-4 border-t border-rule-strong border-b border-rule" aria-label={label}>
  <p class="m-0 mb-2 font-sans text-xs font-semibold uppercase tracking-[.08em] text-fg-muted xl:absolute xl:top-4 xl:-right-[17rem] xl:w-56">{label}</p>
  <div class={`[&>p]:m-0 [&>p+p]:mt-3 ${voice}`}><slot /></div>
  {type === 'my-interpretation' && <p class="m-0 mt-2 font-sans text-sm text-fg-muted">— SR</p>}
</aside>
