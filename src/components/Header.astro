---
import { SITE } from '@/config/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---
<header class="border-b border-rule bg-paper sticky top-0 z-40 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 gap-4">
      
      <!-- Identity -->
      <a href="/" class="font-serif text-lg text-fg hover:text-link transition-colors font-normal tracking-tight">
        {SITE.author.name}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
        {SITE.navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm font-sans transition-colors pb-0.5 ${
                isActive
                  ? 'text-fg font-medium border-b border-rule-strong'
                  : 'text-fg-muted hover:text-fg'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Action Items: Search, Theme Toggle, Mobile Menu -->
      <div class="flex items-center gap-2">
        <!-- Search Trigger -->
        <button
          id="search-btn"
          type="button"
          aria-label="Search articles"
          class="min-h-8 min-w-8 p-1.5 text-xs font-sans text-fg-muted hover:text-fg transition-colors flex items-center justify-center gap-1.5 rounded-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search</span>
        </button>

        <ThemeToggle />

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="md:hidden min-h-8 min-w-8 p-1.5 text-fg-muted hover:text-fg transition-colors flex items-center justify-center rounded-sm"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Panel -->
    <nav
      id="mobile-nav"
      class="hidden md:hidden border-t border-rule py-3 space-y-2"
      aria-label="Mobile navigation"
    >
      {SITE.navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block py-1 text-sm font-sans transition-colors ${
              isActive
                ? 'text-fg font-medium underline underline-offset-4'
                : 'text-fg-muted hover:text-fg'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    function closeMenu() {
      btn?.setAttribute('aria-expanded', 'false');
      nav?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      nav?.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
