---
interface ReferenceItem {
  number: number;
  citation: string;
  shortCitation?: string;
  url?: string;
  doi?: string;
}

interface Props {
  references: ReferenceItem[];
}

const { references } = Astro.props;
---
{references && references.length > 0 && (
  <section id="references" class="space-y-4">
    <div class="flex items-baseline justify-between mb-2">
      <h3 class="font-serif text-lg font-normal text-fg">
        References
      </h3>
      <a href="/evidence-checks" class="font-sans text-xs text-link underline underline-offset-2">
        How I check evidence
      </a>
    </div>

    <ol class="space-y-3 font-sans text-xs text-fg-body list-none pl-0">
      {references.map((ref) => (
        <li id={`ref-${ref.number}`} class="flex items-baseline gap-2.5">
          <span class="text-fg-muted shrink-0 font-medium">
            {ref.number}.
          </span>
          <div class="flex-1 space-y-1">
            <span class="leading-relaxed">{ref.citation}</span>
            <span class="ml-1.5 inline-flex items-center gap-2">
              {ref.doi && (
                <a
                  href={`https://doi.org/${ref.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link underline underline-offset-2"
                >
                  doi:{ref.doi}
                </a>
              )}
              {ref.url && !ref.doi && (
                <a
                  href={ref.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link underline underline-offset-2"
                >
                  Source ↗
                </a>
              )}
              <a
                href={`#ref-back-${ref.number}`}
                title="Return to citation in text"
                class="text-fg-muted hover:text-fg font-sans"
              >
                ↩
              </a>
            </span>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
