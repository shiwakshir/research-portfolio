---
interface Props {
  src: string;
  alt: string;
  caption: string;
  n?: number;
  href?: string;
  linkText?: string;
}

const { src, alt, caption, n, href, linkText = 'Source ↗' } = Astro.props;
---
<figure class="m-0 my-6">
  <div class="border border-rule bg-paper-muted overflow-hidden">
    <img
      src={src}
      alt={alt}
      loading="lazy"
      class="block w-full h-auto dark:brightness-[.92]"
    />
  </div>
  <figcaption class="mt-2 font-sans text-xs text-fg-muted">
    {n && <span>Fig. {n} · </span>}{caption}
    {href && (
      <a href={href} target="_blank" rel="noopener noreferrer" class="ml-2 text-link underline underline-offset-2">
        {linkText}
      </a>
    )}
  </figcaption>
</figure>
