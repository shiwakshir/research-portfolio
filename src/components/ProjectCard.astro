---
import Figure from './Figure.astro';

interface Props {
  title: string;
  summary: string;
  role: string;
  sector: string;
  methods: string[];
  order: number;
  isLead?: boolean;
  award?: string;
  techStack?: string[];
  slug?: string;
  year?: string;
  outcome?: string;
}

const {
  title,
  summary,
  role,
  sector,
  methods = [],
  order,
  isLead = false,
  award,
  slug,
  year,
  outcome,
} = Astro.props;
---
<article class="space-y-4 py-8 border-b border-rule first:pt-0">
  {isLead ? (
    <div class="space-y-4">
      <div class="font-sans text-xs text-fg-muted flex items-center gap-2">
        <span>Lead Research Tool</span>
        <span>·</span>
        <span>{sector}</span>
      </div>

      <h3 class="font-serif text-2xl sm:text-3xl font-normal text-fg">
        {slug ? (
          <a href={`/projects/${slug}`} class="hover:text-link transition-colors">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>

      <p class="summary">
        {summary}
      </p>

      {award && (
        <p class="font-sans text-xs text-fg-muted">
          {award}
        </p>
      )}

      <div class="flex items-center gap-4 pt-1 font-sans text-sm">
        {slug && (
          <a href={`/projects/${slug}`} class="text-link underline underline-offset-2">
            Case study
          </a>
        )}
        <a href="https://github.com/shiwakshir/brief-agent" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">
          Source ↗
        </a>
      </div>

      <div class="pt-4 max-w-3xl">
        <Figure
          src="/brief-architecture.svg"
          alt="BRIEF 11-step methodological audit pipeline"
          caption="BRIEF's 11-step advisory review pipeline."
          n={1}
          href="https://github.com/shiwakshir/brief-agent"
        />
      </div>
    </div>
  ) : (
    <div class="space-y-3">
      <!-- Title in serif -->
      <h3 class="font-serif text-xl sm:text-2xl font-normal text-fg">
        {slug ? (
          <a href={`/projects/${slug}`} class="hover:text-link transition-colors">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>

      <!-- One clean metadata line: Sector · (Year if present) · 2 Methods · Role -->
      <p class="font-sans text-xs text-fg-muted">
        <span>{sector}</span>
        {year && (
          <>
            <span> · </span>
            <span>{year}</span>
          </>
        )}
        <span> · </span>
        <span>{methods.slice(0, 2).join(', ')}</span>
        <span> · </span>
        <span class="text-fg">{role}</span>
      </p>

      {outcome && (
        <p class="font-sans text-xs text-fg-muted italic">
          Outcome: {outcome}
        </p>
      )}

      {slug && (
        <div class="pt-1">
          <a href={`/projects/${slug}`} class="font-sans text-xs text-link underline underline-offset-2">
            Read project case study →
          </a>
        </div>
      )}
    </div>
  )}
</article>
