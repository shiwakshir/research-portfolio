---
interface Props {
  status: 'Literature exploration' | 'Research in progress' | 'Critical review' | string;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;

// Normalized status
const normalized = status.toLowerCase();

let config = {
  label: status,
  colorClasses: 'bg-parchment-200 text-ink-800 border-parchment-300 dark:bg-darkSurface-800 dark:text-ink-100 dark:border-darkSurface-700',
  iconPath: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};

if (normalized.includes('literature')) {
  config = {
    label: 'Literature exploration',
    colorClasses: 'bg-slateAccent-50 text-slateAccent-800 border-slateAccent-200 dark:bg-darkSurface-850 dark:text-slateAccent-200 dark:border-slateAccent-700',
    iconPath: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  };
} else if (normalized.includes('progress')) {
  config = {
    label: 'Research in progress',
    colorClasses: 'bg-forest-50 text-forest-800 border-forest-200 dark:bg-darkSurface-850 dark:text-forest-200 dark:border-forest-700',
    iconPath: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
  };
} else if (normalized.includes('critical') || normalized.includes('review') || normalized.includes('methodological')) {
  config = {
    label: 'Critical review',
    colorClasses: 'bg-parchment-150 text-ink-900 border-parchment-300 dark:bg-darkSurface-850 dark:text-ink-100 dark:border-darkSurface-700',
    iconPath: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  };
}

const sizeClasses = size === 'md' ? 'text-xs px-2.5 py-1 gap-1.5' : 'text-[11px] px-2 py-0.5 gap-1';
---
<a
  href="/evidence-checks"
  title="Click to see how I check and categorize evidence"
  class={`inline-flex items-center rounded-sm border font-medium transition-colors hover:border-forest-600 dark:hover:border-forest-400 focus-visible:ring-1 focus-visible:ring-forest-600 ${config.colorClasses} ${sizeClasses}`}
>
  <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={config.iconPath} />
  </svg>
  <span>{config.label}</span>
</a>
