---
interface Props {
  status: string;
  class?: string;
}

const { status, class: className = '' } = Astro.props;
---
<a
  href="/evidence-checks"
  title="How I check evidence"
  class={`font-sans text-xs text-fg-muted hover:text-link border-b border-dotted border-rule-strong pb-0.5 transition-colors ${className}`}
>
  {status}
</a>
