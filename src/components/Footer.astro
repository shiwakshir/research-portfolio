---
import { SITE } from '@/config/site';

const currentYear = new Date().getFullYear();
---
<footer class="border-t border-rule bg-paper mt-20 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Column 1: Identity & Professional Focus -->
      <div class="md:col-span-2 space-y-2">
        <span class="font-serif text-base font-normal text-fg block">
          {SITE.author.name}
        </span>
        <p class="font-sans text-xs text-fg-muted">
          {SITE.author.fullTitle} · {SITE.author.location}
        </p>
        <p class="font-sans text-xs text-fg-muted max-w-md leading-relaxed pt-1">
          {SITE.author.experienceSummary}
        </p>
      </div>

      <!-- Column 2: Sections -->
      <div class="space-y-2 font-sans text-xs">
        <h3 class="font-semibold uppercase tracking-wider text-fg mb-2">
          Publication
        </h3>
        <ul class="space-y-1.5 text-fg-muted">
          <li><a href="/journal" class="hover:text-fg transition-colors">Journal</a></li>
          <li><a href="/series" class="hover:text-fg transition-colors">Series</a></li>
          <li><a href="/projects" class="hover:text-fg transition-colors">Projects</a></li>
          <li><a href="/interests" class="hover:text-fg transition-colors">Research Themes</a></li>
        </ul>
      </div>

      <!-- Column 3: Standards & Links -->
      <div class="space-y-2 font-sans text-xs">
        <h3 class="font-semibold uppercase tracking-wider text-fg mb-2">
          Methodology & Contact
        </h3>
        <ul class="space-y-1.5 text-fg-muted">
          <li><a href="/evidence-checks" class="text-link underline underline-offset-2">How I check evidence →</a></li>
          <li><a href="/about" class="hover:text-fg transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-fg transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-fg transition-colors">Privacy Notice</a></li>
          <li>
            <a href="/rss.xml" class="hover:text-fg transition-colors inline-flex items-center gap-1">
              RSS Feed
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-rule flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-xs text-fg-muted">
      <p>© {currentYear} {SITE.author.name}. All work documented independently.</p>
      <a href="#" class="hover:text-fg">Back to top ↑</a>
    </div>
  </div>
</footer>
