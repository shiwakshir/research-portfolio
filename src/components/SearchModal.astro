---
---
<div
  id="search-dialog"
  class="fixed inset-0 z-50 hidden bg-fg/40 backdrop-blur-sm flex items-start justify-center pt-20 px-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
>
  <div
    class="w-full max-w-xl bg-paper border border-rule shadow-lg overflow-hidden"
    id="search-container"
  >
    <!-- Search Input Bar -->
    <div class="border-b border-rule p-4 flex items-center gap-3">
      <svg class="w-4 h-4 text-fg-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search published inquiries, methods, or tags..."
        class="w-full bg-transparent font-sans text-sm text-fg placeholder-fg-muted focus:outline-none"
        autocomplete="off"
      />
      <button
        id="search-close-btn"
        type="button"
        aria-label="Close search"
        class="font-sans text-xs px-2 py-1 border border-rule text-fg-muted hover:text-fg"
      >
        ESC
      </button>
    </div>

    <!-- Live Results List -->
    <div id="search-results" class="max-h-96 overflow-y-auto p-4 space-y-2 text-sm">
      <p id="search-initial-msg" class="font-sans text-xs text-fg-muted text-center py-6">
        Type to search across published research articles and literature reviews.
      </p>
      <div id="search-results-list" class="space-y-2"></div>
    </div>

    <div class="p-2.5 bg-paper-muted border-t border-rule font-sans text-xs text-fg-muted flex justify-between items-center px-4">
      <span>Shiwakshi Rashmi · Research Index</span>
      <span>Press <kbd class="font-sans border border-rule px-1 py-0.5">ESC</kbd> to exit</span>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    let searchData = null;
    let lastActiveElement = null;
    const dialog = document.getElementById('search-dialog');
    const searchInput = document.getElementById('search-input');
    const searchCloseBtn = document.getElementById('search-close-btn');
    const resultsContainer = document.getElementById('search-results-list');
    const initialMsg = document.getElementById('search-initial-msg');
    const searchBtn = document.getElementById('search-btn');

    async function loadSearchIndex() {
      if (!searchData) {
        try {
          const res = await fetch('/search.json');
          searchData = await res.json();
        } catch (e) {
          searchData = [];
        }
      }
    }

    function openSearch() {
      lastActiveElement = document.activeElement;
      dialog?.classList.remove('hidden');
      loadSearchIndex();
      setTimeout(() => searchInput?.focus(), 50);
    }

    function closeSearch() {
      dialog?.classList.add('hidden');
      if (searchInput) searchInput.value = '';
      if (resultsContainer) resultsContainer.innerHTML = '';
      if (initialMsg) initialMsg.classList.remove('hidden');
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    searchBtn?.addEventListener('click', openSearch);
    searchCloseBtn?.addEventListener('click', closeSearch);

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (dialog?.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      }
      if (e.key === 'Escape' && !dialog?.classList.contains('hidden')) {
        closeSearch();
      }
    });

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) closeSearch();
    });

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      if (!resultsContainer || !initialMsg) return;

      if (!query) {
        resultsContainer.innerHTML = '';
        initialMsg.classList.remove('hidden');
        return;
      }

      initialMsg.classList.add('hidden');
      resultsContainer.innerHTML = '';

      if (!searchData || searchData.length === 0) {
        const p = document.createElement('p');
        p.className = 'font-sans text-xs text-fg-muted py-4 text-center';
        p.textContent = 'No articles available.';
        resultsContainer.appendChild(p);
        return;
      }

      const matches = searchData.filter(item => {
        return (
          item.title.toLowerCase().includes(query) ||
          item.abstract.toLowerCase().includes(query) ||
          item.category.toLowerCase().includes(query) ||
          (item.tags && item.tags.some(t => t.toLowerCase().includes(query)))
        );
      });

      if (matches.length === 0) {
        const p = document.createElement('p');
        p.className = 'font-sans text-xs text-fg-muted py-4 text-center';
        p.textContent = `No research inquiries found matching "${query}".`;
        resultsContainer.appendChild(p);
        return;
      }

      matches.forEach(item => {
        const a = document.createElement('a');
        a.href = `/journal/${item.slug}`;
        a.className = 'block p-3 border border-rule hover:border-rule-strong transition-colors';

        const meta = document.createElement('div');
        meta.className = 'font-sans text-xs text-fg-muted flex items-center gap-2 mb-1';
        meta.textContent = `No. 0${item.articleNumber || 1} · ${item.category} · ${item.readingTime}`;

        const h = document.createElement('h4');
        h.className = 'font-serif text-base text-fg font-normal leading-snug';
        h.textContent = item.title;

        const desc = document.createElement('p');
        desc.className = 'font-sans text-xs text-fg-body line-clamp-1 mt-1';
        desc.textContent = item.abstract;

        a.appendChild(meta);
        a.appendChild(h);
        a.appendChild(desc);
        resultsContainer.appendChild(a);
      });
    });
  })();
</script>
